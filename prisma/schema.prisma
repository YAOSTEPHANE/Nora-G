generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model SyncBatch {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  batchId        String        @unique
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String?       @db.ObjectId
  sentAt         DateTime
  receivedAt     DateTime      @default(now())
  source         String?
  raw            Json
  status         String        @default("received")
  error          String?
  items          SyncItem[]

  @@index([organizationId, receivedAt])
}

model SyncItem {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  syncBatch   SyncBatch @relation(fields: [syncBatchId], references: [id], onDelete: Cascade)
  syncBatchId String    @db.ObjectId
  kind        String
  createdAt   DateTime
  payload     Json
}

model WebhookEvent {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  source     String
  eventType  String
  externalId String?
  receivedAt DateTime @default(now())
  payload    Json
}

model Organization {
  id                    String                    @id @default(auto()) @map("_id") @db.ObjectId
  name                  String
  email                 String                    @unique
  passwordHash          String?
  licenseKey            String                    @unique
  storeCode             String?                   @unique
  /** Segment d’URL boutique public (nom d’entreprise slugifié). */
  storeSlug             String?                   @unique
  planId                String                    @default("starter")
  status                String                    @default("trialing")
  stripeCustomerId      String?
  stripeSubId           String?
  trialEndsAt           DateTime?
  currentPeriodEnd      DateTime?
  billingProvider       String?
  billingPhone          String?
  smsRemindersEnabled   Boolean                   @default(true)
  /** NIF / identifiant fiscal (FNE Côte d’Ivoire). */
  taxId                 String?
  fiscalRegime          String?                   @default("REEL")
  fneEnabled            Boolean                   @default(false)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  storefrontMenu        Json?
  storefrontPublishedAt DateTime?
  /** Clés paiement commerçant (boutique) — distinctes de la config plateforme. */
  waveApiKey            String?
  waveWebhookSecret     String?
  waveSigningSecret     String?
  waveDemoMode          Boolean                   @default(false)
  cinetpayApiKey        String?
  cinetpaySiteId        String?
  cinetpayDemoMode      Boolean                   @default(false)
  mobilePayments        MobileMoneyPayment[]
  reminderLogs          SubscriptionReminderLog[]
  storefrontOrders      StorefrontOrder[]
  syncBatches           SyncBatch[]
  sessions              OrgSession[]
  staffMembers          StaffMember[]
  integration           OrgIntegration?
  auditLogs             AuditLog[]
}

model OrgSession {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String       @db.ObjectId
  tokenHash      String       @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId, expiresAt])
}

model StaffMember {
  id                   String       @id @default(auto()) @map("_id") @db.ObjectId
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId       String       @db.ObjectId
  profileId            String
  displayName          String
  initials             String
  role                 String
  storeId              String?
  pinHash              String
  passwordHash         String?
  active               Boolean      @default(true)
  /** Overrides granulaires des droits (JSON StaffPermissions partiel). */
  permissionOverrides  Json?
  /** Rôle métier custom côté client (id local). */
  customRoleId         String?
  revokedAt            DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([organizationId, profileId])
  @@index([organizationId, active])
}

model OrgIntegration {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String       @unique @db.ObjectId
  config         Json         @default("{}")
  updatedAt      DateTime     @updatedAt
  createdAt      DateTime     @default(now())
}

model AuditLog {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String?       @db.ObjectId
  action         String
  actor          String?
  metadata       Json?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
}

model StorefrontOrder {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String       @db.ObjectId
  storeCode      String
  externalId     String       @unique
  status         String       @default("pending")
  payload        Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([storeCode, createdAt])
}

model SubscriptionReminderLog {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String       @db.ObjectId
  kind           String
  periodEnd      DateTime
  phone          String
  message        String?
  status         String       @default("sent")
  error          String?
  sentAt         DateTime     @default(now())

  @@unique([organizationId, kind, periodEnd])
}

model MobileMoneyPayment {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String       @db.ObjectId
  planId         String
  transactionId  String       @unique
  channel        String
  amountFcfa     Int
  customerPhone  String
  status         String       @default("pending")
  paymentToken   String?
  operatorId     String?
  paymentMethod  String?
  notifyPayload  Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  paidAt         DateTime?
}

/** Config globale Wave / CinetPay (Orange Money) — editable via /admin. */
model PlatformPaymentConfig {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  /** Singleton : toujours "default". */
  key                String   @unique @default("default")
  waveApiKey         String?
  waveWebhookSecret  String?
  waveSigningSecret  String?
  waveDemoMode       Boolean  @default(false)
  cinetpayApiKey     String?
  cinetpaySiteId     String?
  cinetpayDemoMode   Boolean  @default(false)
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())
}

/** Branding site marketing (logo page d’accueil) — editable via /admin. */
model PlatformSiteBranding {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  /** Singleton : toujours "default". */
  key       String   @unique @default("default")
  /** URL publique (Blob) ou data URL. Null = logo fichier local. */
  logoUrl   String?
  /** Nom affiché optionnel (sinon BRAND_NAME côté client). */
  brandName String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
