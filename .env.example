# Authentification organisation (sessions Bearer — recommandé en production)
# SESSION_TTL_DAYS=30
# Les routes API acceptent Authorization: Bearer cc_sess_… ou x-license-key (legacy).

# Synchronisation cloud (optionnel — fonctionne automatiquement en dev:full via proxy /api).
# POST /api/nora/sync        — envoi local → cloud (push)
# GET  /api/nora/sync/pull   — téléchargement cloud → caisse (pull)
# En local (npm run dev:full) : Next proxy /api vers :4000 — aucune variable requise.
# Production Vercel (fullstack) : Express est servi en serverless via apps/web/api/index.ts ;
#   les appels relatifs /api/... suffisent — ne pas définir NEXT_PUBLIC_API_BASE_URL.
# Frontend séparé uniquement : définir NEXT_PUBLIC_API_BASE_URL (voir ci-dessous).
# Repli legacy (déconseillé) : NEXT_PUBLIC_CLOUD_SYNC_URL=https://api.votredomaine.com/api/nora/sync

# URL du backend Express si le frontend Next est hébergé séparément de l’API.
# Ne pas terminer par /api : l'application l'ajoute automatiquement via apiUrl().
# Inutile sur Vercel fullstack (même domaine + rewrite /api → serverless Express).
# NEXT_PUBLIC_API_BASE_URL=https://api.votredomaine.com

# Backend fullstack (MongoDB + Prisma)
# PORT=4000
# Local MongoDB:
# DATABASE_URL="mongodb://127.0.0.1:27017/nora"
# MongoDB Atlas (obligatoire sur Vercel — renseigner dans le dashboard projet) :
# DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/nora?retryWrites=true&w=majority"

# Abonnements Stripe (optionnel — sans clés, l’essai gratuit et la gestion de licence fonctionnent)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CURRENCY=xof
# URL publique HTTPS de l’app (obligatoire en production pour Stripe/CinetPay/CORS)
# Sur Vercel : https://votre-projet.vercel.app (ou domaine custom)
# APP_URL=https://votre-projet.vercel.app
#
# Variables minimales à renseigner dans Vercel → Settings → Environment Variables :
#   DATABASE_URL, APP_URL
# Optionnel : WAVE_*, CINETPAY_*, BLOB_READ_WRITE_TOKEN
#
# Pages publiques du site :
#   /           → site commercial
#   /inscription → création de compte
#   /staff      → connexion caissier

# Monitoring Sentry (optionnel)
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_TRACES_SAMPLE_RATE=0.1
# VITE_SENTRY_DSN → NEXT_PUBLIC_SENTRY_DSN
# NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Fiscalité Côte d’Ivoire — NIF renseigné par org via PATCH /api/org/fiscal/settings

# Mobile money Côte d’Ivoire
# Préférez Intégrations (clés par magasin) ou les variables d’environnement ci-dessous.
# Les variables ci-dessous restent un repli si aucune clé n’est saisie dans l’admin.
# CINETPAY_API_KEY=votre_apikey
# CINETPAY_SITE_ID=votre_site_id
# CINETPAY_DEMO_MODE=true
# En local sans compte CinetPay : CINETPAY_DEMO_MODE=true active une page de simulation.

# Wave CI — paiement direct via l’API Business Wave (recommandé pour Wave)
# Obtenez vos clés sur https://business.wave.com → Développeur
# Ou configurez-les dans /admin → Wave & Orange
# WAVE_API_KEY=wave_ci_prod_...
# WAVE_WEBHOOK_SECRET=wave_sn_WHS_...   # secret webhook (portal Wave)
# WAVE_SIGNING_SECRET=wave_sn_AKS_...   # optionnel si signature des requêtes activée
# WAVE_DEMO_MODE=true                   # simulation locale sans clé API (pas l’app Wave réelle)
# En production : renseignez WAVE_API_KEY et mettez WAVE_DEMO_MODE=false
# Le client est alors redirigé vers pay.wave.com (app Wave CI ou QR à scanner).
# Webhook à enregistrer : https://votredomaine.com/api/billing/wave/webhook
# Événements : checkout.session.completed, checkout.session.payment_failed

# SMS (rappels abonnement + commandes en ligne)
# SMS_PROVIDER_URL=https://votre-prestataire-sms.com/send
# SMS_PROVIDER_TOKEN=...
# SUBSCRIPTION_REMINDER_INTERVAL_HOURS=6

# Authentification obligatoire des webhooks génériques (/webhooks/*)
# Envoyer cette valeur dans l'en-tête x-webhook-token.
# WEBHOOK_TOKEN=generez-un-secret-aleatoire-long

# Stockage fichiers — Vercel Blob (photos produits catalogue)
# Créez un store sur https://vercel.com/dashboard/stores puis copiez le token « Read-Write ».
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# Sans ce token, les photos restent en data URL locale (IndexedDB, max 500 Ko).
