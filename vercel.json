{
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npx prisma generate && npm run build -w @nora/web",
  "functions": {
    "apps/web/api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "{server/**,prisma/**,node_modules/.prisma/client/**,node_modules/@prisma/client/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    }
  ]
}
