{
  "name": "nora",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/ensure-web-src-link.mjs",
    "dev": "npm run dev -w @nora/web",
    "dev:api": "tsx watch server/server.ts",
    "dev:full": "concurrently -k -n API,WEB -c green,cyan \"npm:dev:api\" \"npm:dev\"",
    "prebuild": "prisma generate",
    "build": "npm run build:api && npm run build -w @nora/web",
    "build:api": "tsc -p tsconfig.server.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "start": "npm run start -w @nora/web",
    "start:api": "node server-dist/server.js",
    "db:up": "docker compose up -d mongo",
    "db:down": "docker compose down",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "db:canonicalize-emails": "tsx server/scripts/canonicalize-org-emails.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@prisma/client": "^6.8.0",
    "@sentry/node": "^10.69.0",
    "@sentry/react": "^10.69.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@vercel/blob": "^2.4.0",
    "cors": "^2.8.5",
    "dexie": "^4.4.1",
    "dexie-react-hooks": "^4.4.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.3.0",
    "lucide-react": "^1.8.0",
    "morgan": "^1.10.0",
    "next": "^16.3.0",
    "next-pwa": "^5.6.0",
    "postcss": "^8.5.25",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^24.12.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "prisma": "^6.8.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.19.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "serialize-javascript": "^7.0.3",
    "esbuild": "^0.25.12"
  }
}
