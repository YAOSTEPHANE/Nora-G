{
  "framework": "nextjs",
  "installCommand": "cd ../.. && npm ci",
  "buildCommand": "cd ../.. && npx prisma generate && npm run build -w @nora/web",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "{../../server/**,../../prisma/**,../../node_modules/.prisma/client/**,../../node_modules/@prisma/client/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    }
  ]
}
